{
  "name": "highnote",
  "version": "1.0.25",
  "private": true,
  "type": "module",
  "description": "Local Markdown comments with flat replies and recoverable text anchors.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "lint": "eslint src",
    "package": "node scripts/package.mjs",
    "install:local": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "happy-dom": "^21.0.1",
    "obsidian": "1.14.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
